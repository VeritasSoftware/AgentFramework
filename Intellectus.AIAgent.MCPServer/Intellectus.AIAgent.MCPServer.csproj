<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	  <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
	  <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
	  <Description>A MCP Server for Intellectus AI Agents using OpenAI LLMs.</Description>
	  <PackageProjectUrl>https://github.com/VeritasSoftware/AgentFramework</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/VeritasSoftware/AgentFramework</RepositoryUrl>
	  <PackageTags>intellectus ai agent framework openai mcp server</PackageTags>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <IsPackable>true</IsPackable>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	  <Authors>Shantanu</Authors>
	  <Company>Veritas Software</Company>
	  <Version>1.0.0</Version>
	  <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
	  <Title>Intellectus.AIAgent.MCPServer</Title>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

	<ItemGroup>
		<Content Include="README.md">
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
		</Content>
	</ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intellectus.AIAgent.Framework\Intellectus.AIAgent.Framework.csproj" />
  </ItemGroup>

</Project>
